# ---- Required ----
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/nexachat
JWT_SECRET=

# Optional
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# Public base URL used to build uploaded file links.
# Set this to your deployed backend origin in production.
PUBLIC_BASE_URL=

# local | cloudinary | s3  (cloudinary/s3 also need their packages installed
# and the keys below filled in)
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Browser push notifications ----
# Generate once with:  node -e "const w=require('web-push');const k=w.generateVAPIDKeys();console.log(k.publicKey);console.log(k.privateKey)"
# Then paste both values below. Public key is 87 chars, private key is 43 chars.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@nexachat.app

# Set to production in a deployed environment (enables trust proxy).
NODE_ENV=development

# Dev only: return the reset token in the API response (no mail provider yet).
# Ignored when NODE_ENV=production. The reset link is always printed in the
# server log in development, so you normally do not need this at all.
EXPOSE_RESET_TOKEN=false
